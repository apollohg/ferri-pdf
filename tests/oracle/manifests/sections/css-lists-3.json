        "requirement_ids": [
          "css-lists-3.inheriting-counters"
        ]
      },
      "controlling_definitions": [
        {
          "behaviour": "Counter identity inheritance chooses the previous sibling, falling back to the parent; counter values follow matching preceding-tree-order instances.",
          "reason": "CSSWG revision 90a9a54ecce4863ae98706a8dd0d33d510718973 (6 March 2026) reverted the 2020 parent-first rule. Historical source and requirements remain preserved.",
          "controlling": {
            "source_id": "css-lists-3-2026-counters",
            "section_id": "inheriting-counters"
          },
          "basis": {
            "source_id": "css-lists-3-2026-counters",
