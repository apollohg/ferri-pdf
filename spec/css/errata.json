{
  "description": "Corrections to mdn-data from the cited specifications: productions the data references but does not define, and entries that predate the current specification. Each entry replaces only the fields it names. Additions are specification properties the data omits, defined in full.",
  "syntaxes": {
    "single-animation": {
      "syntax": "[ auto | <time [0s,∞]> ] || <easing-function> || <time> || <single-animation-iteration-count> || <single-animation-direction> || <single-animation-fill-mode> || <single-animation-play-state> || [ none | <keyframes-name> ] || <single-animation-timeline>",
      "source": "https://www.w3.org/TR/2023/WD-css-animations-2-20230602/#animation-shorthand with one value per list item: the first <time> is the duration and the second the delay (https://www.w3.org/TR/2023/WD-css-animations-1-20230302/#animation)"
    },
    "single-animation-range": {
      "syntax": "normal | <length-percentage> | <timeline-range-name> <length-percentage>?",
      "source": "https://drafts.csswg.org/scroll-animations-1/#animation-range-start: one item of the list, which the animation-range shorthand takes per entry"
    },
    "feature-tag-value": {
      "syntax": "<string> [ <integer [0,∞]> | on | off ]?",
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#feature-tag-value"
    },
    "content-list": {
      "syntax": "[ <string> | <image> | <attr()> | contents | <quote> | <leader()> | <target> | <string()> | <content()> | <counter> ]+",
      "source": "https://www.w3.org/TR/2025/WD-css-content-3-20251204/#content-values"
    },
    "string()": {
      "syntax": "string( <custom-ident> [ , [ first | start | last | first-except ] ]? )",
      "source": "https://www.w3.org/TR/2025/WD-css-content-3-20251204/#string-function; optional second argument in prose"
    },
    "target-counter()": {
      "syntax": "target-counter( [ <string> | <url> ] , <custom-ident> [ , <counter-style> ]? )",
      "source": "https://www.w3.org/TR/2025/WD-css-content-3-20251204/#target-counter; optional counter-style in prose and examples"
    },
    "target-counters()": {
      "syntax": "target-counters( [ <string> | <url> ] , <custom-ident> , <string> [ , <counter-style> ]? )",
      "source": "https://www.w3.org/TR/2025/WD-css-content-3-20251204/#target-counters"
    },
    "target-text()": {
      "syntax": "target-text( [ <string> | <url> ] [ , [ content | before | after | first-letter ] ]? )",
      "source": "https://www.w3.org/TR/2025/WD-css-content-3-20251204/#target-text; optional second argument in prose"
    },
    "named-string-content": {
      "syntax": "[ <string> | <counter()> | <counters()> | <content()> | <attr()> ]+",
      "source": "https://www.w3.org/TR/2024/WD-css-gcpm-3-20240125/#setting-named-strings-the-string-set-pro"
    },
    "font-format": {
      "syntax": "<string> | collection | embedded-opentype | opentype | svg | truetype | woff | woff2",
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-face-src-parsing"
    },
    "font-tech": {
      "syntax": "features-opentype | features-aat | features-graphite | color-COLRv0 | color-COLRv1 | color-SVG | color-sbix | color-CBDT | variations | palettes | incremental",
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-face-src-parsing"
    },
    "font-source-format": {
      "syntax": "format( <font-format> )",
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-face-src-parsing"
    },
    "font-source-tech": {
      "syntax": "tech( <font-tech># )",
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-face-src-parsing"
    },
    "attr-name": {
      "syntax": "[ <ident>? '|' ]? <ident>",
      "source": "https://drafts.csswg.org/css-values-5/#typedef-attr-name"
    },
    "autospace": {
      "syntax": "no-autospace | [ ideograph-alpha || ideograph-numeric || punctuation ] || [ insert | replace ]",
      "source": "https://www.w3.org/TR/2026/WD-css-text-4-20260814/#typedef-autospace"
    },
    "spacing-trim": {
      "syntax": "space-all | normal | space-first | trim-start | trim-both | trim-all",
      "source": "https://www.w3.org/TR/2026/WD-css-text-4-20260814/#typedef-spacing-trim"
    },
    "counter-style": {
      "syntax": "<counter-style-name> | <symbols()>",
      "source": "https://drafts.csswg.org/css-counter-styles-3/#typedef-counter-style"
    },
    "circle()": {
      "syntax": "circle( [ <radial-extent> | <length-percentage [0,∞]> ]? [ at <position> ]? )",
      "source": "https://www.w3.org/TR/2025/CRD-css-shapes-1-20250612/#funcdef-basic-shape-circle with the <radial-size> of https://www.w3.org/TR/2025/WD-css-images-4-20250930/#radial-size, whose two-component values are invalid for circle()"
    },
    "ellipse()": {
      "syntax": "ellipse( [ <radial-extent> | [ <length-percentage [0,∞]> | closest-side | farthest-side ]{2} ]? [ at <position> ]? )",
      "source": "https://www.w3.org/TR/2025/CRD-css-shapes-1-20250612/#funcdef-basic-shape-ellipse with the <radial-size> of https://www.w3.org/TR/2025/WD-css-images-4-20250930/#radial-size: one extent for both radii, or a horizontal and a vertical radius"
    },
    "bottom": {
      "syntax": "<length> | auto",
      "source": "https://www.w3.org/TR/CSS21/visufx.html#value-def-shape"
    },
    "fixed-breadth": {
      "syntax": "<length-percentage [0,∞]>",
      "source": "https://drafts.csswg.org/css-grid-1/#typedef-fixed-breadth"
    },
    "inflexible-breadth": {
      "syntax": "<length-percentage [0,∞]> | min-content | max-content | auto",
      "source": "https://drafts.csswg.org/css-grid-1/#typedef-inflexible-breadth"
    },
    "track-breadth": {
      "syntax": "<length-percentage [0,∞]> | <flex [0,∞]> | min-content | max-content | auto",
      "source": "https://drafts.csswg.org/css-grid-1/#typedef-track-breadth"
    },
    "track-size": {
      "syntax": "<track-breadth> | minmax( <inflexible-breadth> , <track-breadth> ) | fit-content( <length-percentage [0,∞]> )",
      "source": "https://drafts.csswg.org/css-grid-1/#typedef-track-size"
    },
    "intrinsic-size-keyword": {
      "syntax": "auto | min-content | max-content | fit-content | stretch",
      "source": "https://drafts.csswg.org/css-values-5/#calc-size"
    },
    "left": {
      "syntax": "<length> | auto",
      "source": "https://www.w3.org/TR/CSS21/visufx.html#value-def-shape"
    },
    "right": {
      "syntax": "<length> | auto",
      "source": "https://www.w3.org/TR/CSS21/visufx.html#value-def-shape"
    },
    "syntax": {
      "syntax": "'*' | <syntax-component> [ <syntax-combinator> <syntax-component> ]* | <syntax-string>",
      "source": "https://drafts.css-houdini.org/css-properties-values-api-1/#syntax-strings"
    },
    "syntax-combinator": {
      "syntax": "'|'",
      "source": "https://drafts.css-houdini.org/css-properties-values-api-1/#syntax-strings"
    },
    "syntax-component": {
      "syntax": "<syntax-single-component> <syntax-multiplier>? | '<' transform-list '>'",
      "source": "https://drafts.css-houdini.org/css-properties-values-api-1/#syntax-strings"
    },
    "syntax-multiplier": {
      "syntax": "'#' | '+'",
      "source": "https://drafts.css-houdini.org/css-properties-values-api-1/#syntax-strings"
    },
    "syntax-single-component": {
      "syntax": "'<' <syntax-type-name> '>' | <ident>",
      "source": "https://drafts.css-houdini.org/css-properties-values-api-1/#syntax-strings"
    },
    "syntax-string": {
      "syntax": "<string>",
      "source": "https://drafts.css-houdini.org/css-properties-values-api-1/#syntax-strings"
    },
    "syntax-type-name": {
      "syntax": "angle | color | custom-ident | image | integer | length | length-percentage | number | percentage | resolution | string | time | url | transform-function",
      "source": "https://drafts.css-houdini.org/css-properties-values-api-1/#supported-names"
    },
    "top": {
      "syntax": "<length> | auto",
      "source": "https://www.w3.org/TR/CSS21/visufx.html#value-def-shape"
    },
    "x": {
      "syntax": "<number>",
      "source": "https://drafts.csswg.org/css-ui-4/#cursor"
    },
    "y": {
      "syntax": "<number>",
      "source": "https://drafts.csswg.org/css-ui-4/#cursor"
    },
    "content()": {
      "syntax": "content( [ text | before | after | first-letter | marker ]? )",
      "source": "https://drafts.csswg.org/css-gcpm-3/#content-function-header"
    },
    "image-set-option": {
      "syntax": "[ <image> | <string> ] [ <resolution> || type(<string>) ]?",
      "source": "https://www.w3.org/TR/2025/WD-css-images-4-20250930/#image-set-notation"
    },
    "display-legacy": {
      "syntax": "inline-block | inline-list-item | inline-table | inline-flex | inline-grid | -webkit-box | -webkit-inline-box",
      "source": "https://compat.spec.whatwg.org/commit-snapshots/159624eff7222f84fbdaae006e998e65bf60daa0/#css-keyword-mappings: -webkit-box and -webkit-inline-box, which https://www.w3.org/TR/2023/WD-css-overflow-4-20230321/#webkit-line-clamp requires to compute as themselves"
    },
    "dasharray": {
      "syntax": "[ [ <length-percentage [0,∞]> | <number [0,∞]> ]+ ]#",
      "source": "https://www.w3.org/TR/2026/CR-SVG2-20261006/painting.html#StrokeDasharrayProperty: a list with a negative value is invalid"
    }
  },
  "properties": {
    "appearance": {
      "syntax": "none | auto | base | base-select | <compat-auto> | <compat-special>",
      "source": "https://drafts.csswg.org/css-ui-4/#appearance-switching: the base and base-select keywords"
    },
    "background-position": {
      "initial": [
        "background-position-x",
        "background-position-y"
      ],
      "source": "https://drafts.csswg.org/css-backgrounds-4/#background-position: a shorthand for background-position-x and background-position-y"
    },
    "animation": {
      "initial": [
        "animation-name",
        "animation-duration",
        "animation-timing-function",
        "animation-delay",
        "animation-iteration-count",
        "animation-direction",
        "animation-fill-mode",
        "animation-play-state",
        "animation-timeline",
        "animation-range-start",
        "animation-range-end"
      ],
      "source": "https://drafts.csswg.org/scroll-animations-1/#animation-range: the animation-range properties are reset-only sub-properties of the animation shorthand"
    },
    "animation-range": {
      "syntax": "[ <single-animation-range> <single-animation-range>? ]#",
      "source": "https://drafts.csswg.org/scroll-animations-1/#animation-range with one start and end per list item"
    },
    "overscroll-behavior": {
      "initial": ["overscroll-behavior-x", "overscroll-behavior-y"],
      "source": "https://drafts.csswg.org/css-overscroll-1/#overscroll-behavior-properties: a shorthand for overscroll-behavior-x and overscroll-behavior-y"
    },
    "scroll-timeline": {
      "syntax": "[ [ none | <dashed-ident> ] [ block | inline | x | y ]? ]#",
      "source": "https://drafts.csswg.org/scroll-animations-1/#scroll-timeline-shorthand with one name and axis per list item"
    },
    "speak-as": {
      "initial": "normal",
      "source": "https://www.w3.org/TR/2023/CRD-css-speech-1-20230214/#speaking-props-speak-as"
    },
    "text-box": {
      "initial": [
        "text-box-trim",
        "text-box-edge"
      ],
      "source": "https://drafts.csswg.org/css-inline-3/#text-box-shorthand: a shorthand for text-box-trim and text-box-edge"
    },
    "text-size-adjust": {
      "syntax": "auto | none | <percentage [0,∞]>",
      "initial": "auto",
      "source": "https://drafts.csswg.org/css-size-adjust-1/#adjustment-control"
    },
    "view-timeline": {
      "syntax": "[ [ none | <dashed-ident> ] [ [ block | inline | x | y ] || [ auto | <length-percentage> ]{1,2} ]? ]#",
      "initial": ["view-timeline-name", "view-timeline-axis", "view-timeline-inset"],
      "source": "https://drafts.csswg.org/scroll-animations-1/#view-timeline-shorthand: sets view-timeline-name, view-timeline-axis and view-timeline-inset, one of each per list item"
    },
    "object-position": {
      "inherited": false,
      "source": "https://www.w3.org/TR/2023/CRD-css-images-3-20231218/#the-object-position"
    },
    "font-style": {
      "syntax": "normal | italic | left | right | oblique <angle [-90deg,90deg]>?",
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-style-prop"
    },
    "font": {
      "initial": [
        "font-family",
        "font-size",
        "font-width",
        "font-style",
        "font-variant",
        "font-weight",
        "line-height",
        "font-feature-settings",
        "font-kerning",
        "font-language-override",
        "font-optical-sizing",
        "font-size-adjust",
        "font-variation-settings"
      ],
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-prop"
    },
    "font-variant": {
      "syntax": "normal | none | [ <common-lig-values> || <discretionary-lig-values> || <historical-lig-values> || <contextual-alt-values> || stylistic( <feature-value-name> ) || historical-forms || styleset( <feature-value-name># ) || character-variant( <feature-value-name># ) || swash( <feature-value-name> ) || ornaments( <feature-value-name> ) || annotation( <feature-value-name> ) || [ small-caps | all-small-caps | petite-caps | all-petite-caps | unicase | titling-caps ] || <numeric-figure-values> || <numeric-spacing-values> || <numeric-fraction-values> || ordinal || slashed-zero || <east-asian-variant-values> || <east-asian-width-values> || ruby || [ sub | super ] || [ text | emoji | unicode ] ]",
      "initial": [
        "font-variant-alternates",
        "font-variant-caps",
        "font-variant-east-asian",
        "font-variant-emoji",
        "font-variant-ligatures",
        "font-variant-numeric",
        "font-variant-position"
      ],
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-variant-prop"
    },
    "font-stretch": {
      "syntax": "<'font-width'>",
      "initial": [
        "font-width"
      ],
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-stretch-prop"
    },
    "quotes": {
      "syntax": "auto | none | match-parent | [ <string> <string> ]+",
      "initial": "auto",
      "source": "https://www.w3.org/TR/2025/WD-css-content-3-20251204/#quotes-property"
    },
    "font-synthesis": {
      "initial": ["font-synthesis-weight", "font-synthesis-style", "font-synthesis-small-caps", "font-synthesis-position"],
      "source": "https://drafts.csswg.org/css-fonts-4/#font-synthesis"
    },
    "font-synthesis-position": {
      "initial": "auto",
      "source": "https://www.w3.org/TR/2026/WD-css-fonts-4-20261022/#font-synthesis-position"
    },
    "column-count": {
      "syntax": "auto | <integer [1,∞]>",
      "source": "https://drafts.csswg.org/css-multicol-1/#propdef-column-count"
    },
    "column-fill": {
      "syntax": "auto | balance | balance-all",
      "source": "https://drafts.csswg.org/css-multicol-1/#propdef-column-fill"
    },
    "column-rule-style": {
      "syntax": "<line-style>",
      "source": "https://drafts.csswg.org/css-multicol-1/#propdef-column-rule-style"
    },
    "column-rule-width": {
      "syntax": "<line-width>",
      "source": "https://drafts.csswg.org/css-multicol-1/#propdef-column-rule-width"
    },
    "flex-grow": {
      "syntax": "<number [0,∞]>",
      "source": "https://drafts.csswg.org/css-flexbox-1/#flex-grow-property"
    },
    "flex-shrink": {
      "syntax": "<number [0,∞]>",
      "source": "https://drafts.csswg.org/css-flexbox-1/#flex-shrink-property"
    },
    "grid": {
      "initial": ["grid-template-rows", "grid-template-columns", "grid-template-areas", "grid-auto-rows", "grid-auto-columns", "grid-auto-flow"],
      "source": "https://drafts.csswg.org/css-grid-1/#grid-shorthand"
    },
    "grid-column-gap": {
      "syntax": "<'column-gap'>",
      "initial": ["column-gap"],
      "source": "https://drafts.csswg.org/css-align-3/#gap-legacy"
    },
    "grid-gap": {
      "syntax": "<'row-gap'> <'column-gap'>?",
      "initial": ["row-gap", "column-gap"],
      "source": "https://drafts.csswg.org/css-align-3/#gap-legacy"
    },
    "grid-row-gap": {
      "syntax": "<'row-gap'>",
      "initial": ["row-gap"],
      "source": "https://drafts.csswg.org/css-align-3/#gap-legacy"
    },
    "letter-spacing": {
      "syntax": "normal | <length-percentage>",
      "source": "https://drafts.csswg.org/css-text-4/#letter-spacing-property"
    },
    "line-height": {
      "syntax": "normal | <number [0,∞]> | <length-percentage [0,∞]>",
      "source": "https://drafts.csswg.org/css-inline-3/#line-height-property"
    },
    "shape-margin": {
      "syntax": "<length-percentage [0,∞]>",
      "source": "https://www.w3.org/TR/2025/CRD-css-shapes-1-20250612/#shape-margin-property"
    },
    "overflow": {
      "initial": ["overflow-x", "overflow-y"],
      "source": "https://drafts.csswg.org/css-overflow-3/#propdef-overflow"
    },
    "page-break-after": {
      "initial": ["break-after"],
      "source": "https://drafts.csswg.org/css-break-3/#page-break-properties"
    },
    "page-break-before": {
      "initial": ["break-before"],
      "source": "https://drafts.csswg.org/css-break-3/#page-break-properties"
    },
    "page-break-inside": {
      "initial": ["break-inside"],
      "source": "https://drafts.csswg.org/css-break-3/#page-break-properties"
    },
    "text-decoration": {
      "initial": ["text-decoration-line", "text-decoration-style", "text-decoration-color", "text-decoration-thickness"],
      "source": "https://drafts.csswg.org/css-text-decor-4/#text-decoration-property"
    },
    "text-decoration-thickness": {
      "syntax": "auto | from-font | <length-percentage>",
      "source": "https://drafts.csswg.org/css-text-decor-4/#text-decoration-thickness-property"
    },
    "text-underline-offset": {
      "syntax": "auto | <length-percentage>",
      "source": "https://drafts.csswg.org/css-text-decor-4/#underline-offset"
    },
    "text-align": {
      "initial": "start",
      "source": "https://drafts.csswg.org/css-text-3/#text-align-property"
    },
    "white-space": {
      "initial": ["white-space-collapse", "text-wrap-mode"],
      "source": "https://www.w3.org/TR/2026/WD-css-text-4-20260814/#white-space-property: a shorthand for white-space-collapse and text-wrap-mode"
    },
    "text-wrap": {
      "initial": ["text-wrap-mode", "text-wrap-style"],
      "source": "https://www.w3.org/TR/2026/WD-css-text-4-20260814/#text-wrap: a shorthand for text-wrap-mode and text-wrap-style"
    },
    "word-break": {
      "syntax": "normal | break-all | keep-all | manual | auto-phrase | break-word",
      "source": "https://www.w3.org/TR/2026/WD-css-text-4-20260814/#word-break-property"
    },
    "text-spacing-trim": {
      "syntax": "<spacing-trim> | auto",
      "source": "https://www.w3.org/TR/2026/WD-css-text-4-20260814/#text-spacing-trim-property"
    },
    "text-justify": {
      "syntax": "auto | none | inter-word | inter-character | distribute",
      "source": "https://www.w3.org/TR/2026/CRD-css-text-3-20260814/#text-justify-property with the distribute keyword its prose requires"
    },
    "initial-letter": {
      "syntax": "normal | <number [1,∞]> <integer [1,∞]> | <number [1,∞]> && [ drop | raise ]?",
      "source": "https://www.w3.org/TR/2024/WD-css-inline-3-20241218/#sizing-drop-initials"
    },
    "initial-letter-align": {
      "syntax": "[ border-box? [ alphabetic | ideographic | hanging | leading ]? ]!",
      "initial": "alphabetic",
      "inherited": true,
      "source": "https://www.w3.org/TR/2024/WD-css-inline-3-20241218/#aligning-initial-letter"
    },
    "hyphenate-limit-chars": {
      "syntax": "[ auto | <integer [0,∞]> ]{1,3}",
      "source": "https://www.w3.org/TR/2026/WD-css-text-4-20260814/#hyphenate-char-limits"
    },
    "max-lines": {
      "syntax": "none | <integer [1,∞]>",
      "source": "https://www.w3.org/TR/2023/WD-css-overflow-4-20230321/#max-lines"
    },
    "line-clamp": {
      "syntax": "none | <integer [1,∞]> <'block-ellipsis'>?",
      "initial": ["max-lines", "block-ellipsis", "continue"],
      "source": "https://www.w3.org/TR/2023/WD-css-overflow-4-20230321/#line-clamp: a shorthand for max-lines, block-ellipsis and continue"
    },
    "-webkit-line-clamp": {
      "syntax": "none | <integer [1,∞]>",
      "initial": ["max-lines", "block-ellipsis", "continue"],
      "source": "https://www.w3.org/TR/2023/WD-css-overflow-4-20230321/#webkit-line-clamp: a shorthand for max-lines, block-ellipsis and continue"
    },
    "transform-origin": {
      "syntax": "[ left | center | right | top | bottom | <length-percentage> ] | [ left | center | right | <length-percentage> ] [ top | center | bottom | <length-percentage> ] <length>? | [ [ center | left | right ] && [ center | top | bottom ] ] <length>?",
      "source": "https://drafts.csswg.org/css-transforms-1/#transform-origin-property"
    },
    "vertical-align": {
      "syntax": "baseline | sub | super | text-top | text-bottom | middle | top | bottom | <length-percentage>",
      "source": "https://drafts.csswg.org/css-inline-3/#baseline-shift-property"
    },
    "widows": {
      "syntax": "<integer [1,∞]>",
      "source": "https://drafts.csswg.org/css-break-3/#widows-orphans"
    },
    "orphans": {
      "syntax": "<integer [1,∞]>",
      "source": "https://drafts.csswg.org/css-break-3/#widows-orphans"
    },
    "word-spacing": {
